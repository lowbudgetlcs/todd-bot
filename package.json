{
  "name": "todd-bot",
  "version": "0.0.4",
  "description": "",
  "types": "dist/index.d.ts",
  "main": "dist/index.js",
  "scripts": {
    "format": "prettier --write .",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "tsup src/* --minify",
    "build-ws": "tsup src/**/* --minify",
    "start": "pm2-runtime ./dist/index.js ",
    "go": "tsup src/* --minify && pm2-runtime ./dist/index.js",
    "go-ws": "tsup src/*/** --minify && pm2-runtime ./dist/index.js"
  },
  "author": "ruuffian",
  "license": "MIT",
  "dependencies": {
    "@fightmegg/riot-api": "^0.0.20",
    "@swc/core": "^1.4.2",
    "croner": "^8.1.1",
    "discord.js": "^14.17.3",
    "dotenv": "^16.4.5",
    "drizzle-orm": "^0.38.4",
    "loglevel": "^1.9.2",
    "npm": "^11.0.0",
    "pg": "^8.13.1",
    "pm2": "^5.4.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/compat": "^1.3.2",
    "@eslint/js": "^9.33.0",
    "@types/loglevel": "^1.5.4",
    "@types/node": "^22.13.1",
    "drizzle-kit": "^0.30.4",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^15.15.0",
    "prettier": "^3.3.3",
    "ts-node": "^10.9.2",
    "tsup": "^8.3.6",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.40.0",
    "vitest": "^3.2.7"
  }
}
