# Required - the bot refuses to start if any of these are missing.
# See docs/DEVELOPMENT.md for where to get each one.

# Discord
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
GUILD_ID=

# Dennys (LBLCS backend). API_URL must include the /api/v1 prefix - Todd appends
# bare paths (/eventGroup, /event/{id}) straight onto it. No trailing slash.
# e.g. https://dennys.lowbudgetlcs.com/api/v1
API_URL=
DENNYS_TOKEN=

# LBLCS draft backend + public draft site
LOWBUDGETLCS_BACKEND_URL=
LOWBUDGETLCS_DRAFT_URL=

# Riot. Validated at boot but unused on the current code path - a dummy value
# is fine locally.
RIOT_API_TOKEN=

# Optional - defaults shown.
# STATE_DIR=./data       # where state.json (selected event group) is persisted
# API_TIMEOUT_MS=20000   # per-attempt timeout on outbound HTTP; must be > 0
# API_RETRIES=2          # retry budget, GET requests only; 0 disables retries
# POST_GAME_FORM_URL=  # link posted when a series finishes; defaults to the current LBLCS form
